}

def get_sound_index(key_name):
    for idx, (val, _) in enumerate(SOUND_OPTIONS):
        if val == key_name:
            return idx
    return 0

def get_sound_value(index):
    if 0 <= index < len(SOUND_OPTIONS):
        return SOUND_OPTIONS[index][0]
    return "volume_bubble"

