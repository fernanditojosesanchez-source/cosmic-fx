diff --git a/src/config/fx.rs b/src/config/fx.rs
new file mode 100644
index 00000000..336cf768
--- /dev/null
+++ b/src/config/fx.rs
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use serde::{Deserialize, Serialize};
+use std::path::PathBuf;
+use std::sync::{LazyLock, RwLock};
+
+static CURRENT_FX: LazyLock<RwLock<FxConfig>> = LazyLock::new(|| {
+    RwLock::new(FxConfig::load_or_default_from_disk())
+});
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct FxConfig {
+    pub preset: String,
+    pub wobbly_enabled: bool,
+    pub wobbly_intensity: f64,
+    pub spring_bounce_enabled: bool,
+    pub focus_glow_enabled: bool,
+    pub card_lift_enabled: bool,
+    pub pendulum_tilt_enabled: bool,
+    #[serde(default = "default_true")]
+    pub floating_mode: bool,
+    #[serde(default = "default_true")]
+    pub pop_sound_enabled: bool,
+    #[serde(default = "default_close_style")]
+    pub close_animation_style: String,
+    #[serde(default = "default_sound_effect")]
+    pub pop_sound_effect: String,
+    #[serde(default = "default_true")]
+    pub pop_sound_on_close: bool,
+    #[serde(default = "default_true")]
+    pub pop_sound_on_open: bool,
+    #[serde(default = "default_true")]
+    pub pop_sound_on_maximize: bool,
+    #[serde(default = "default_false")]
+    pub pop_sound_on_minimize: bool,
+    #[serde(default = "default_sound_close")]
+    pub sound_close_effect: String,
+    #[serde(default = "default_sound_open")]
+    pub sound_open_effect: String,
+    #[serde(default = "default_sound_maximize")]
+    pub sound_maximize_effect: String,
+    #[serde(default = "default_sound_minimize")]
+    pub sound_minimize_effect: String,
+}
+
+fn default_true() -> bool {
+    true
+}
+
+fn default_false() -> bool {
+    false
+}
+
+fn default_close_style() -> String {
+    "pop_bubble".to_string()
+}
+
+fn default_sound_effect() -> String {
+    "volume_bubble".to_string()
+}
+
+fn default_sound_close() -> String {
+    "volume_bubble".to_string()
+}
+
+fn default_sound_open() -> String {
+    "volume_bubble".to_string()
+}
+
+fn default_sound_maximize() -> String {
+    "swing".to_string()
+}
+
+fn default_sound_minimize() -> String {
+    "click".to_string()
+}
+
+impl Default for FxConfig {
+    fn default() -> Self {
+        Self::preset_snappy()
+    }
+}
+
+impl FxConfig {
+    pub fn current() -> Self {
+        CURRENT_FX.read().unwrap().clone()
+    }
+
+    pub fn set_current(new_cfg: Self) {
+        *CURRENT_FX.write().unwrap() = new_cfg;
+    }
+
+    pub fn preset_snappy() -> Self {
+        Self {
+            preset: "snappy".to_string(),
+            wobbly_enabled: true,
+            wobbly_intensity: 1.0,
+            spring_bounce_enabled: true,
+            focus_glow_enabled: true,
+            card_lift_enabled: true,
+            pendulum_tilt_enabled: true,
+            floating_mode: true,
+            pop_sound_enabled: true,
+            close_animation_style: "pop_bubble".to_string(),
+            pop_sound_effect: "volume_bubble".to_string(),
+            pop_sound_on_close: true,
+            pop_sound_on_open: true,
+            pop_sound_on_maximize: true,
+            pop_sound_on_minimize: false,
+            sound_close_effect: "volume_bubble".to_string(),
+            sound_open_effect: "volume_bubble".to_string(),
+            sound_maximize_effect: "swing".to_string(),
+            sound_minimize_effect: "click".to_string(),
+        }
+    }
+
+    pub fn preset_intense() -> Self {
+        Self {
+            preset: "intense".to_string(),
+            wobbly_enabled: true,
+            wobbly_intensity: 2.2,
+            spring_bounce_enabled: true,
+            focus_glow_enabled: true,
+            card_lift_enabled: true,
+            pendulum_tilt_enabled: true,
+            floating_mode: true,
+            pop_sound_enabled: true,
+            close_animation_style: "pop_bubble".to_string(),
+            pop_sound_effect: "volume_bubble".to_string(),
+            pop_sound_on_close: true,
+            pop_sound_on_open: true,
+            pop_sound_on_maximize: true,
+            pop_sound_on_minimize: false,
+            sound_close_effect: "volume_bubble".to_string(),
+            sound_open_effect: "volume_bubble".to_string(),
+            sound_maximize_effect: "swing".to_string(),
+            sound_minimize_effect: "click".to_string(),
+        }
+    }
+
+    pub fn preset_subtle() -> Self {
+        Self {
+            preset: "subtle".to_string(),
+            wobbly_enabled: true,
+            wobbly_intensity: 0.5,
+            spring_bounce_enabled: true,
+            focus_glow_enabled: true,
+            card_lift_enabled: true,
+            pendulum_tilt_enabled: true,
+            floating_mode: true,
+            pop_sound_enabled: true,
+            close_animation_style: "pop_bubble".to_string(),
+            pop_sound_effect: "volume_bubble".to_string(),
+            pop_sound_on_close: true,
+            pop_sound_on_open: true,
+            pop_sound_on_maximize: true,
+            pop_sound_on_minimize: false,
+            sound_close_effect: "click".to_string(),
+            sound_open_effect: "click".to_string(),
+            sound_maximize_effect: "swing".to_string(),
+            sound_minimize_effect: "click".to_string(),
+        }
+    }
+
+    pub fn preset_off() -> Self {
+        Self {
+            preset: "off".to_string(),
+            wobbly_enabled: false,
+            wobbly_intensity: 0.0,
+            spring_bounce_enabled: false,
+            focus_glow_enabled: false,
+            card_lift_enabled: false,
+            pendulum_tilt_enabled: false,
+            floating_mode: false,
+            pop_sound_enabled: false,
+            close_animation_style: "classic".to_string(),
+            pop_sound_effect: "volume_bubble".to_string(),
+            pop_sound_on_close: false,
+            pop_sound_on_open: false,
+            pop_sound_on_maximize: false,
+            pop_sound_on_minimize: false,
+            sound_close_effect: "volume_bubble".to_string(),
+            sound_open_effect: "volume_bubble".to_string(),
+            sound_maximize_effect: "swing".to_string(),
+            sound_minimize_effect: "click".to_string(),
+        }
+    }
+
+    pub fn apply_preset(&mut self, preset_name: &str) {
+        match preset_name.to_lowercase().as_str() {
+            "intense" | "boom" => *self = Self::preset_intense(),
+            "subtle" | "smooth" => *self = Self::preset_subtle(),
+            "off" | "disabled" | "none" => *self = Self::preset_off(),
+            _ => *self = Self::preset_snappy(),
+        }
+    }
+
+    pub fn config_path() -> PathBuf {
+        if let Ok(sandbox) = std::env::var("XDG_CONFIG_HOME") {
+            let p = PathBuf::from(&sandbox).join("cosmic-comp-fx.json");
+            if p.exists() || PathBuf::from(&sandbox).exists() {
+                return p;
+            }
+        }
+        if let Ok(home) = std::env::var("HOME") {
+            PathBuf::from(home).join(".config/cosmic/cosmic-comp-fx.json")
+        } else {
+            PathBuf::from("/tmp/cosmic-comp-fx.json")
+        }
+    }
+
+    pub fn load_or_default_from_disk() -> Self {
+        let path = Self::config_path();
+        if let Ok(content) = std::fs::read_to_string(&path) {
+            if let Ok(cfg) = serde_json::from_str::<FxConfig>(&content) {
+                return cfg;
+            }
+        }
+        let default_cfg = Self::default();
+        let _ = default_cfg.save();
+        default_cfg
+    }
+
+    pub fn reload_if_changed() -> bool {
+        let path = Self::config_path();
+        if let Ok(content) = std::fs::read_to_string(&path) {
+            if let Ok(cfg) = serde_json::from_str::<FxConfig>(&content) {
+                let current = Self::current();
+                if cfg != current {
+                    Self::set_current(cfg);
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
+    pub fn save(&self) -> std::io::Result<()> {
+        let path = Self::config_path();
+        if let Some(parent) = path.parent() {
+            let _ = std::fs::create_dir_all(parent);
+        }
+        let json = serde_json::to_string_pretty(self)
+            .map_err(|e| std::io::Error::new(std::io::ErrorKind::Other, e))?;
+        std::fs::write(path, json)
+    }
+}
+
+pub fn resolve_sound_path(effect_name: &str) -> &'static str {
+    match effect_name {
+        "pin" => "/usr/share/sounds/Pop/stereo/action/audio-volume-change.oga",
+        "click" => "/usr/share/sounds/gnome/default/alerts/click.ogg",
+        "swing" => "/usr/share/sounds/gnome/default/alerts/swing.ogg",
+        "camera_focus" => "/usr/share/sounds/Pop/stereo/action/camera-focus.oga",
+        "theme_demo" => "/usr/share/sounds/Pop/stereo/notification/theme-demo.oga",
+        "device_added" => "/usr/share/sounds/Pop/stereo/notification/device-added.oga",
+        "device_removed" => "/usr/share/sounds/Pop/stereo/notification/device-removed.oga",
+        _ => "/usr/share/sounds/freedesktop/stereo/audio-volume-change.oga",
+    }
+}
+
+pub fn play_sound_effect(effect_name: &str) {
+    let cfg = FxConfig::current();
+    if !cfg.pop_sound_enabled {
+        return;
+    }
+    let sound_path = resolve_sound_path(effect_name);
+    if !std::path::Path::new(sound_path).exists() {
+        return;
+    }
+    let sound_path = sound_path.to_string();
+    std::thread::spawn(move || {
+        let played = std::process::Command::new("pw-play")
+            .arg(&sound_path)
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .and_then(|mut child| child.wait())
+            .is_ok();
+
+        if !played {
+            let _ = std::process::Command::new("paplay")
+                .arg(&sound_path)
+                .stdout(std::process::Stdio::null())
+                .stderr(std::process::Stdio::null())
+                .spawn()
+                .and_then(|mut child| child.wait());
+        }
+    });
+}
+
+pub fn play_sound_close() {
+    let cfg = FxConfig::current();
+    if cfg.pop_sound_enabled && cfg.pop_sound_on_close {
+        play_sound_effect(&cfg.sound_close_effect);
+    }
+}
+
+pub fn play_sound_open() {
+    let cfg = FxConfig::current();
+    if cfg.pop_sound_enabled && cfg.pop_sound_on_open {
+        play_sound_effect(&cfg.sound_open_effect);
+    }
+}
+
+pub fn play_sound_maximize() {
+    let cfg = FxConfig::current();
+    if cfg.pop_sound_enabled && cfg.pop_sound_on_maximize {
+        play_sound_effect(&cfg.sound_maximize_effect);
+    }
+}
+
+pub fn play_sound_minimize() {
+    let cfg = FxConfig::current();
+    if cfg.pop_sound_enabled && cfg.pop_sound_on_minimize {
+        play_sound_effect(&cfg.sound_minimize_effect);
+    }
+}
+
+/// Reproduce el sonido de cierre o Pop de respaldo
+pub fn play_pop_sound() {
+    play_sound_close();
+}
